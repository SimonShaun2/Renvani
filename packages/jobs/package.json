{
  "name": "@fsm/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./enqueue-migrate-file-batch": {
      "types": "./dist/enqueue-migrate-file-batch.d.ts",
      "import": "./dist/enqueue-migrate-file-batch.js"
    },
    "./enqueue-import-chunk-commit": {
      "types": "./dist/enqueue-import-chunk-commit.d.ts",
      "import": "./dist/enqueue-import-chunk-commit.js"
    },
    "./migrate-file-batch-trace-log": {
