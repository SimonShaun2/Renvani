# apps/api — staging / production (redacted)
# Injection: Railway service variables (FS-93 Option A). Values distinct per environment.
# Startup loads full @fsm/config schema — include every key from local-dev.env.example even if unused in API code paths.

NODE_ENV=production
API_PORT=3001

DATABASE_URL=
REDIS_URL=
# FS-66 rate limiting. Verify the real client IP before enabling the global limiter (see docs/platform/FS-93-render-runbook.md).
# 0-10. URGENT on Render: 0 = request.ip is Render's proxy (per-IP limits shared by all clients); verify hops in staging.
TRUST_PROXY_HOPS=0
GLOBAL_RATE_LIMIT_ENABLED=false
GLOBAL_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_SLOT_HOLD_IP_RATE_LIMIT_MAX=6
PUBLIC_SLOT_HOLD_COMPANY_RATE_LIMIT_MAX=120
PUBLIC_SLOT_HOLD_RATE_LIMIT_WINDOW_SECONDS=600

APP_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
BOOKING_HOLD_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
RESET_TOKEN_TTL_SECONDS=
ESTIMATE_EXPIRY_DAYS=
INVOICE_DUE_DAYS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PLATFORM_FEE_PERCENT=

OPENAI_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional — STACK-07 Langfuse tracing (disabled when unset)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: shared secret sent by the Vercel web proxy as x-origin-secret (same value on Vercel web). Unset = use request.ip.
# ORIGIN_SECRET=
