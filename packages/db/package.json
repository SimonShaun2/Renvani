{
  "name": "@fsm/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:golden-import-e2e": "vitest run src/golden-import-e2e.integration.test.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:check-migrations": "pnpm run build && node ./scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@fsm/import-normalize": "workspace:*",
    "@fsm/config": "workspace:*",
    "@fsm/types": "workspace:*",
    "decimal.js": "^10.5.0",
    "drizzle-orm": "0.44.2",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "0.31.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
