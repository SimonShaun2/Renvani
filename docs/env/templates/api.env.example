# apps/api — staging / production (redacted)
# Injection: Render API service environment. Use isolated tester values in staging.
# Required at API boot by @fsm/config/runtime-env; conditional adapter values are
# injected only when that adapter is enabled. Never copy a whole workspace .env.

RENVANI_DEPLOYMENT_TIER=staging
NODE_ENV=production
API_PORT=3001

DATABASE_URL=
REDIS_URL=
# FS-66 rate limiting. Verify the real client IP before enabling the global limiter (see docs/platform/FS-93-render-runbook.md).
# 0-10. URGENT on Render: 0 = request.ip is Render's proxy (per-IP limits shared by all clients); verify hops in staging.
TRUST_PROXY_HOPS=0
GLOBAL_RATE_LIMIT_ENABLED=false
GLOBAL_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_SLOT_HOLD_IP_RATE_LIMIT_MAX=6
PUBLIC_SLOT_HOLD_COMPANY_RATE_LIMIT_MAX=120
PUBLIC_SLOT_HOLD_RATE_LIMIT_WINDOW_SECONDS=600

APP_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
BOOKING_HOLD_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
RESET_TOKEN_TTL_SECONDS=
ESTIMATE_EXPIRY_DAYS=
INVOICE_DUE_DAYS=

STRIPE_SECRET_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# API payment adapter configuration (required by payment view when used).
STRIPE_PLATFORM_FEE_PERCENT=

# Optional API/Clerk boundary settings, only when configured for the tester target.
# APP_URL_ALLOWED=
# CLERK_AUTHORIZED_PARTIES=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=

# Conditional provider credentials are configured only for enabled adapters;
# the API boot view excludes webhook signing, worker AI, Twilio and R2 keys.

# Optional — STACK-07 Langfuse tracing (disabled when unset)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: shared secret sent by the Vercel web proxy as x-origin-secret (same value on Vercel web). Unset = use request.ip.
# ORIGIN_SECRET=
