# apps/worker — staging / production (redacted)
# Injection: Render worker service environment. @fsm/config/runtime-env worker view
# requires only the data plane and APP_URL at boot. Adapter keys are conditional.

RENVANI_DEPLOYMENT_TIER=staging
NODE_ENV=production

DATABASE_URL=
REDIS_URL=

APP_URL=

# Optional worker view: set only when outbound notification/source replay is enabled.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# EMAIL_FROM=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# TWILIO_FROM_NUMBER=
# SOURCE_QUEUE_REPLAY_ENABLED=false

# AI and R2 adapters validate their own credentials when enabled; do not inject
# API Stripe, session JWT or inbound webhook signing keys into the worker.
