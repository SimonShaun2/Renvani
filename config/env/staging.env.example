# FS-75 staging template — copy to a local file outside git; fill via secret manager after FS-93.
# Validate: node scripts/staging/validate-env-boundaries.mjs --tier staging <your-file>

RENVANI_DEPLOYMENT_TIER=staging
NODE_ENV=production

# --- Public origins (replace staging.example after FS-93 DNS) ---
APP_URL=https://app.staging.example
NEXT_PUBLIC_API_URL=https://api.staging.example
API_URL=https://api.staging.example

# --- Data plane (staging-dedicated instances only) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/renvani_staging
REDIS_URL=redis://HOST:6379
# FS-66 rate limiting. Verify the real client IP before enabling the global limiter (see docs/platform/FS-93-render-runbook.md).
# 0-10. URGENT on Render: 0 = request.ip is Render's proxy (per-IP limits shared by all clients); verify hops in staging.
TRUST_PROXY_HOPS=0
GLOBAL_RATE_LIMIT_ENABLED=false
GLOBAL_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_SLOT_HOLD_IP_RATE_LIMIT_MAX=6
PUBLIC_SLOT_HOLD_COMPANY_RATE_LIMIT_MAX=120
PUBLIC_SLOT_HOLD_RATE_LIMIT_WINDOW_SECONDS=600

# --- Auth (generate unique values per environment; never reuse production) ---
JWT_SECRET=replace-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-64
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
RESET_TOKEN_TTL_SECONDS=3600

# --- Stripe (TEST MODE ONLY on staging) ---
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_TEST
STRIPE_CONNECT_CLIENT_ID=ca_REPLACE_TEST
# Legacy, no longer customer-facing; the customer Service Fee is SERVICE_FEE_RATE_BPS (2%) in @fsm/config/stripe-pricing
STRIPE_PLATFORM_FEE_PERCENT=0.02

# --- Messaging / AI (sandbox or staging projects) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@staging.example
OPENAI_API_KEY=

# --- Object storage (staging-only bucket) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=renvani-staging

# --- Service ports (platform may inject; local smoke only) ---
API_PORT=3001
WEBHOOK_PORT=3002
