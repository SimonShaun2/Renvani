# FS-76: names only in docs/security/FS-76-secrets-env-inventory.md — never commit values

# Optional: development | staging | production — see config/env/staging.env.example (FS-75)
# RENVANI_DEPLOYMENT_TIER=development

NODE_ENV=development
# Render injects PORT; local dev uses API_PORT / WEBHOOK_PORT
# PORT=
API_PORT=3001
WEBHOOK_PORT=3002

DATABASE_URL=
# Optional database pool (defaults: pool max 10 in dev/prod, 1 in test)
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_SECONDS=20
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
# DATABASE_SERVICE_MAX_CONNECTIONS=100
# DATABASE_TRANSACTION_MAX_RETRIES=3
# DATABASE_TRANSACTION_RETRY_BASE_MS=25
# FSM_PROCESS_ROLE=api
REDIS_URL=
# Break-glass only: enable in an audited trusted-operations shell, never on shared app runtimes.
SOURCE_QUEUE_REPLAY_ENABLED=false
# FS-66 rate limiting. Verify the real client IP before enabling the global limiter (see docs/platform/FS-93-render-runbook.md).
# 0-10. URGENT on Render: 0 = request.ip is Render's proxy (per-IP limits shared by all clients); verify hops in staging.
TRUST_PROXY_HOPS=0
GLOBAL_RATE_LIMIT_ENABLED=false
GLOBAL_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_SLOT_HOLD_IP_RATE_LIMIT_MAX=6
PUBLIC_SLOT_HOLD_COMPANY_RATE_LIMIT_MAX=120
PUBLIC_SLOT_HOLD_RATE_LIMIT_WINDOW_SECONDS=600
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Legacy (still required, decimal fraction, e.g. 0.02): no longer customer-facing; the customer Service Fee is SERVICE_FEE_RATE_BPS (2%) in @fsm/config/stripe-pricing
STRIPE_PLATFORM_FEE_PERCENT=
STRIPE_PLATFORM_BILLING_PRICE_ID_FLEX=
STRIPE_PLATFORM_BILLING_PRICE_ID_FLAT=
# Legacy alias for Flex price when STRIPE_PLATFORM_BILLING_PRICE_ID_FLEX unset
STRIPE_PLATFORM_BILLING_PRICE_ID=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Transactional email (Resend). Missing key = email disabled (logged once, no-op).
RESEND_API_KEY=
EMAIL_FROM="Renvani <hello@mail.getrenvani.com>"
# Optional absolute https URL of the Renvani logo for emails (blank = HTML text mark)
EMAIL_LOGO_URL=
# Growth marketing intake (optional): notify inbox + IP hash salt
MARKETING_NOTIFY_EMAIL=
MARKETING_IP_HASH_SALT=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
APP_URL=http://localhost:3000
JWT_SECRET=
JWT_REFRESH_SECRET=
BOOKING_HOLD_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
RESET_TOKEN_TTL_SECONDS=3600
ESTIMATE_EXPIRY_DAYS=30
INVOICE_DUE_DAYS=30
NEXT_PUBLIC_API_URL=http://localhost:3001
RENAVANI_INTERNAL_COMPANY_ID=
# Optional: server-side API origin for Next.js public-route rewrites (defaults to NEXT_PUBLIC_API_URL)
API_URL=http://localhost:3001
# FS-133 QuickBooks Online (sandbox only until founder approves production)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3001/api/v1/quickbooks-online/connect/callback
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=

# Clerk (web). Keys only via env; never commit values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key: web server (@clerk/nextjs) and API (staging only: Clerk parallel auth is on when RENVANI_DEPLOYMENT_TIER=staging)
CLERK_SECRET_KEY=
# Clerk webhook signing secret (whsec_...) for POST /api/v1/webhooks/clerk
CLERK_WEBHOOK_SECRET=
# Comma-separated web origins: Clerk authorizedParties (azp) + CORS
CLERK_AUTHORIZED_PARTIES=

# Web: marketing product visuals from Webflow CMS (server-side only; never commit values)
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_PRODUCT_VISUALS_COLLECTION_ID=
WEBFLOW_PAGE_SECTIONS_COLLECTION_ID=
